{
  "name": "qnfo-skill-sync",
  "main": "skill-sync.js",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "d1_databases": [
    {"binding": "AUDIT_DB", "database_name": "qnfo-audit", "database_id": "35e2e573-92f3-46ac-83c6-22f6429fc5e5"}
  ],

  "r2_buckets": [
    {"binding": "SKILLS_BUCKET", "bucket_name": "qnfo-skills"}
  ],

  "ai": {
    "binding": "AI"
  },

  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "vars": {
    "SKILLS_REPO": "QNFO/qnfo-skills",
    "SKILLS_BRANCH": "master"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.5
  }
}
